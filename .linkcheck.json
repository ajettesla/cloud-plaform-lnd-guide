{
  "aliveStatusCodes": [200, 301, 302],
  "retryOn429": true,
  "retryCount": 3,
  "fallbackToHEAD": true,
  "headers": {
    "User-Agent": "markdown-link-check/3.11.0 (LND Cloud Guide)"
  },
  "replacementPatterns": [
    {
      "pattern": "^\\.\\./",
      "replacement": "https://github.com/ajettesla/cloud-plaform-lnd-guide/tree/main/docs/"
    }
  ],
  "ignorePatterns": [
    "^https://github.com/ajettesla/lnd-terraform-modules",
    "^https://github.com/lightningnetwork/lnd",
    "^mailto:",
    "^#"
  ]
}
